# Copy this file to .env.local (git-ignored, never committed) and fill in the
# real values below from your own Supabase and Google AI projects.

# ── Supabase ──────────────────────────────────────────────────────────────
# Supabase Dashboard → your project → Project Settings → API.

# Project URL — looks like https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" key (safe to expose to the browser — it only works
# through Row Level Security policies, see supabase/schema.sql).
# Do NOT put the "service_role" key here or anywhere in this project —
# that key bypasses Row Level Security and must never reach the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI provider ──────────────────────────────────────────────────────────
# Google Gemini is the only AI provider for this project.
AI_PROVIDER=gemini

# Google AI Studio → https://aistudio.google.com/apikey
# Server-only — deliberately has NO NEXT_PUBLIC_ prefix so it is never sent
# to the browser. Only used inside app/api/** route handlers.
GEMINI_API_KEY=

# Optional — override the default Gemini model.
# GEMINI_MODEL=gemini-3.6-flash

# Without the Supabase values, the app will show a clear
# "Missing Supabase configuration" message instead of starting.
# With AI_PROVIDER=gemini and no GEMINI_API_KEY, sending a chat message
# will return a clear "Missing AI configuration" error instead of a reply.
